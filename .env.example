# SQL Server (Sequelize + tedious) — use DB_* vars below, not ADO.NET DATABASE_URL alone
DB_HOST=localhost
DB_PORT=1433
DB_NAME=myfirstdb
DB_USER=sa
DB_PASSWORD=your_sql_password_here

# Windows only: set to true to use Integrated Security (omit DB_USER/DB_PASSWORD)
# DB_USE_INTEGRATED_AUTH=true

DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# DB_LOGGING=true

JWT_SECRET=change_me_use_openssl_rand_hex_32
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@eliteeventhub.com
ADMIN_PASSWORD=change_me_before_production

# Frontend (optional — defaults work with Vite proxy in dev)
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:4000
