{
  "name": "elite-event-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm start --workspace=client\" \"npm start --workspace=server\"",
    "client": "npm start --workspace=client",
    "server": "npm start --workspace=server",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
